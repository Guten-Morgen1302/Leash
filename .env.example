# HTTP service
PORT=4317
LEASH_PUBLIC_URL=http://127.0.0.1:4317
LEASH_DB=leash.db
LEASH_MANDATE=mandate.json

# Use a long random value whenever hooks or live sandbox refunds are enabled.
LEASH_TOKEN=
# Set to the number of trusted reverse-proxy hops (for example, 1 on Render).
LEASH_TRUST_PROXY=
# Set to 1 outside the public transparency demo.
LEASH_LOCK_OPERATOR_ENDPOINTS=

# PayPal sandbox only. Leaving these empty keeps the service in simulated mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional advisory summaries and policy-draft compilation.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional MCP and ledger controls.
LEASH_EXPOSE_AMOUNT_TOOL=
LEASH_LEDGER_KEY=
