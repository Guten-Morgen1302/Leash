# Copy to .env and fill in. SANDBOX ONLY. Every variable is optional unless noted; with none set, Leash runs in SIMULATED mode.
PAYPAL_CLIENT_ID=                 # optional: needed only for LIVE-FIRE mode and seeding
PAYPAL_CLIENT_SECRET=             # optional: server-side only, never commit
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
SEED_CARD_NUMBER=                 # optional: from the sandbox credit card generator
SEED_CARD_EXPIRY=2030-12
SEED_CARD_CVV=123
GEMINI_API_KEY=                   # optional: AI risk summary; recorded summaries are used without it
LEASH_TOKEN=                      # optional locally; required when hosted (protects hook endpoints)
LEASH_LEDGER_KEY=                 # optional: HMAC key for the ledger seal
