{
  "name": "leash",
  "version": "0.1.0",
  "private": true,
  "description": "Author, authorize, verify: a payment-specific mandate gate for AI agents that move money through PayPal (sandbox).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec --test-timeout=60000 \"tests/**/*.test.ts\"",
    "test:node-sqlite": "cross-env LEASH_DB_DRIVER=node:sqlite node --disable-warning=ExperimentalWarning --test --test-reporter=spec --test-timeout=60000 \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "web:build": "vite build --config web/vite.config.ts",
    "web:typecheck": "tsc --noEmit -p web/tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "demo": "npm run web:build && npm run start",
    "reset": "node scripts/reset.mjs",
    "replay": "node scripts/replay.mjs",
    "doctor": "node scripts/doctor.mjs",
    "hooks:print": "node scripts/print-hooks.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "better-sqlite3": "^12.0.0",
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^7.0.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}