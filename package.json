{
  "name": "leash",
  "version": "0.1.0",
  "private": true,
  "description": "Author, authorize, verify: a payment-specific mandate gate for AI agents that move money through PayPal (sandbox).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec --test-timeout=60000 \"tests/**/*.test.ts\"",
    "test:node-sqlite": "cross-env LEASH_DB_DRIVER=node:sqlite node --disable-warning=ExperimentalWarning --test --test-reporter=spec --test-timeout=60000 \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.0.0",
    "express": "^5.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.9.0"
  }
}
